# Copy this file to .env and set your contact email address.
# This email is used in the HTTP User-Agent header for polite requests to Wikipedia APIs.

CONTACT_EMAIL=your-email@example.com

# Optionally, you can append a secondary product token to the User-Agent.
# Use the standard product token format (e.g., YourApp/2.3 or YourApp/2.3; extra info)
# This will produce a header like:
#   User-Agent: WikiReferencesExtractor/1.0 (your-email@example.com) YourApp/2.3
# Uncomment and set as needed:
# SECONDARY_USER_AGENT=YourApp/2.3
